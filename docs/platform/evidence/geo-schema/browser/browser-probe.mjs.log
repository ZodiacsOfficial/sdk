  await started('n2');check('Explicit shard retry deduplicates and does not evict index or other pending shard',counts.index===2&&counts.n===2&&counts.s===1,{...counts});
  pending.get('s1').release();pending.get('n2').release();
  const recovered=await page.evaluate(async()=>{
