  runtime={node:process.version,chrome:browser.version(),executablePath,esbuild:esbuildVersion};
  context=await browser.newContext({viewport:{width:1000,height:700},reducedMotion:'reduce'});
  context.on('request',request=>browserRequests.push({url:request.url(),method:request.method(),postData:request.postData(),type:request.resourceType()}));
  await context.route('**/*',async route=>{
    const request=route.request(),url=new URL(request.url());
    if(url.origin!==baseURL){await route.abort();return;}
    if(assets.has(url.pathname)&&url.search===''){await route.continue();return;}
    if(url.pathname==='/observer-check'&&url.search===''){await route.fulfill({status:204});return;}
    const key={'/data/index.json':'index','/data/n.json':'n','/data/s.json':'s','/data/0.json':'zero'}[url.pathname];
    if(!key||url.search||request.method()!=='GET'){await route.abort();return;}
    const sequence=++counts[key];
    const record={path:url.pathname,sequence,status:200};intercepted.push(record);
    const waiting=pending.get(`${key}${sequence}`);
    if(waiting){waiting.start();await waiting.released;}
    let value;
    if(key==='index') value=sequence===1?{error:'SYNTHETIC_SCHEMA_SECRET',count:2}:syntheticIndex;
    else if(key==='n') value=sequence===1?[north,['Other Synthetic',0,0,0,1000,2000,9,0]]:[north];
    else if(key==='s')value=[south];else value=[];
