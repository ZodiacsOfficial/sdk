    const before=JSON.stringify(north[0]);
    metadata[0].timeZones[0]='Mutated/Zone';metadata[0].shards.length=0;north[0][0].latitude=99;
    const [metadataAgain,northAgain,southAgain]=await Promise.all([window.__client.preload(),window.__client.searchCities('new'),window.__client.searchCities('south')]);
