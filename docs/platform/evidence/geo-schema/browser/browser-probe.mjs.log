  await context.addInitScript(()=>{
    window.__blocked=[],window.__fetchCalls=[];
    const blocked=name=>function(){window.__blocked.push(name);throw new Error('Blocked synthetic capability')};
    for(const name of ['localStorage','sessionStorage','indexedDB','caches'])Object.defineProperty(window,name,{configurable:true,get:blocked(name)});
    for(const name of ['XMLHttpRequest','WebSocket','EventSource'])Object.defineProperty(window,name,{configurable:true,value:blocked(name)});
    Object.defineProperty(navigator,'sendBeacon',{configurable:true,value:blocked('sendBeacon')});
    Object.defineProperty(navigator,'serviceWorker',{configurable:true,get:blocked('serviceWorker')});
