const pending = new Map();
function gate(name) {
  let release, start;
  const released = new Promise(resolve => { release=resolve; });
  const started = new Promise(resolve => { start=resolve; });
  const item={release,start,started,released}; pending.set(name,item); return item;
}
for (const name of ['index1','index2','n1','n2','s1']) gate(name);
async function started(name) {
  let timer;
  try { await Promise.race([pending.get(name).started,new Promise((_,reject)=>{timer=setTimeout(()=>reject(new Error(`Expected request did not start: ${name}`)),10000)})]); }
  finally { clearTimeout(timer); }
}
function check(name, pass, detail=null) { checks.push({name,pass:Boolean(pass),detail}); assert(pass,name); }
