  });
  check('Later explicit retry succeeds and successful results stay cached',recovered.sameNorth&&recovered.storedNorth&&recovered.south[0].name==='South Synthetic City'&&JSON.stringify(recovered.south)===JSON.stringify(recovered.southAgain),recovered);
  check('Caller metadata and city mutation do not alter cache',recovered.metadata.timeZones[0]==='UTC'&&JSON.stringify(recovered.metadata.shards)==='["n","s","0"]');
