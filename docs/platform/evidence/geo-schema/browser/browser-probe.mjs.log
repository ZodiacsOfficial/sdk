// Required inputs ensure this harness cannot silently run against SDK workspace dist.
const consumer = process.env.GEO_PACKED_CONSUMER_DIR;
const archive = process.env.GEO_PACKED_ARCHIVE;
const expectedSHA256 = process.env.GEO_PACKED_SHA256;
const expectedVersion = process.env.GEO_PACKED_VERSION;
assert(consumer && archive && expectedVersion && /^[a-f0-9]{64}$/.test(expectedSHA256 ?? ''), 'Final consumer, archive, version and SHA256 are required');
const out = dirname(fileURLToPath(import.meta.url));
const hash = bytes => createHash('sha256').update(bytes).digest('hex');
const installed = join(consumer, 'node_modules/@zodiacs/engine');
const archiveBytes = await readFile(archive);
assert.equal(hash(archiveBytes), expectedSHA256);
const members = readPackageArchive(archiveBytes);
for (const [name, bytes] of members) assert.deepEqual(await readFile(join(installed, name)), bytes, `Installed bytes match archive: ${name}`);
const manifest = JSON.parse(await readFile(join(installed, 'package.json'), 'utf8'));
assert.equal(manifest.name, '@zodiacs/engine');
assert.equal(manifest.version, expectedVersion);
assert.equal(esbuildVersion, '0.28.1');

async function bundle(entry, label) {
  const result = await build({
    absWorkingDir: consumer,
    stdin: { contents: `export * from ${JSON.stringify(entry)};`, resolveDir: consumer, sourcefile: `${label}-public-entry.mjs` },
    bundle: true, platform: 'browser', format: 'esm', target: 'es2022', write: false, metafile: true, minify: false
  });
  assert.equal(result.outputFiles.length, 1);
  const inputs = [];
  for (const [name, facts] of Object.entries(result.metafile.inputs)) {
    const path = resolve(consumer, name);
    if (path === join(consumer, `${label}-public-entry.mjs`)) continue;
    assert(!name.includes('@zodiacs/sdk') && !/solana|wallet|ownership|web3/i.test(name), 'No ownership/wallet graph imported');
    inputs.push({ file: relative(consumer, path), sha256: hash(await readFile(path)), imports: facts.imports });
  }
  return { code: result.outputFiles[0].text, sha256: hash(result.outputFiles[0].contents), inputs, metafile: result.metafile };
}

const geo = await bundle('@zodiacs/engine/geo', 'geo');
const root = await bundle('@zodiacs/engine', 'root');
assert(geo.inputs.every(input => input.file.startsWith('node_modules/@zodiacs/engine/dist/') && !input.file.endsWith('/index.js')), 'Geo bundle is restricted to installed optional engine modules');
assert(!geo.code.includes('astronomy-engine') && !geo.code.includes('function natalChart') && !geo.code.includes('getCrossChainZodiacsOwnership'), 'Geo imports neither ephemeris, engine root nor ownership execution');
assert(!root.code.includes('createGeoNamesClient') && !root.code.includes('Invalid GeoNames'), 'Public root does not pull GeoNames implementation');
assert(!root.inputs.some(input => input.file.endsWith('/geo.js')), 'Public root graph omits optional geo entry');
await writeFile(join(out, 'geo.bundle.js'), geo.code);
await writeFile(join(out, 'bundle-graphs.json'), JSON.stringify({esbuild:esbuildVersion, geo:{sha256:geo.sha256,inputs:geo.inputs,metafile:geo.metafile}, root:{sha256:root.sha256,inputs:root.inputs,metafile:root.metafile}}, null, 2)+'\n');

const html = '<!doctype html><html lang="en"><meta charset="utf-8"><link rel="icon" href="data:,"><title>Synthetic packed geo browser probe</title><body><h1>Synthetic packed geo browser probe</h1><p id="status">Preparing controlled requests.</p></body></html>';
const assets = new Map([['/', {type:'text/html',body:html}], ['/geo.js',{type:'text/javascript',body:geo.code}]]);
const serverRequests = [], browserRequests = [], intercepted = [], errors = [], checks = [];
