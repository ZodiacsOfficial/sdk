  await started('index2');check('Explicit index retry is shared while pending',counts.index===2);pending.get('index2').release();
  await Promise.all([started('n1'),started('s1')]);
  check('Concurrent searches share pending shard after cached index',counts.n===1&&counts.s===1&&counts.index===2,{...counts});
  pending.get('n1').release();
  const invalidShard=await page.evaluate(async()=>{const r=await window.__north;return{errors:r.map(x=>({status:x.status,name:x.reason?.name,message:x.reason?.message})),same:r.every(x=>x.reason===r[0].reason)}});
  check('Malformed HTTP200 shard rejects with fixed error before partial result',invalidShard.same&&invalidShard.errors.every(x=>x.status==='rejected'&&x.name==='TypeError'&&x.message==='Invalid GeoNames shard data.'),invalidShard);
  check('Shard rejection causes no automatic retry',counts.n===1);
