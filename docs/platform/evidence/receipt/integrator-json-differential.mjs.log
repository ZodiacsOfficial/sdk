import fs from 'node:fs';
import assert from 'node:assert/strict';
import crypto from 'node:crypto';
import {createRequire} from 'node:module';
const root='/private/tmp/zodiacs-platform-sdk',require=createRequire(`${root}/package.json`),ts=require('typescript');
const source=fs.readFileSync(`${root}/packages/engine/src/receipt-json.ts`,'utf8');
const module={exports:{}};new Function('module','exports',ts.transpileModule(source,{compilerOptions:{module:ts.ModuleKind.CommonJS,target:ts.ScriptTarget.ES2022}}).outputText)(module,module.exports);
const {parseReceiptJson}=module.exports,limits={depth:12,nodes:4096};
let state=0x72656365;const random=()=>{state^=state<<13;state^=state>>>17;state^=state<<5;return(state>>>0)/4294967296;};
const pick=values=>values[Math.floor(random()*values.length)];
function value(depth=0){
 const choice=depth===4?Math.floor(random()*4):Math.floor(random()*6);
 if(choice===0)return null;if(choice===1)return random()<0.5;if(choice===2)return (random()-0.5)*10**Math.floor(random()*20);
 if(choice===3)return Array.from({length:Math.floor(random()*20)},()=>pick(['a','"','\\','\n','\t','\u0000','é','é','🪐','\u2028'])).join('');
 if(choice===4)return Array.from({length:Math.floor(random()*4)},()=>value(depth+1));
 return Object.fromEntries(Array.from({length:Math.floor(random()*4)},(_,i)=>[`${pick(['a','é','\\','"','🪐'])}${i}`,value(depth+1)]));
}
const failures=[];let validCases=0,mutationCases=0;
for(let i=0;i<1500;i++){
 const text=JSON.stringify(value(),null,pick([undefined,2,'\t']));const parsed=parseReceiptJson(text,limits);
 try{assert.equal(parsed.ok,true);assert.deepEqual(parsed.value,JSON.parse(text));}catch(error){failures.push({kind:'valid',text,error:error.message});}
 validCases++;
}
const seeds=['null','true','false','0','-0','1.2e+3','"hello \\"quoted\\" world"','"\\u0061"','[1,true,null,["a",false],{}]'];
const chars='nulltruefals0123456789+-.eE"\\u[]{}:, \n\t\r/xab';
for(let i=0;i<20000;i++){
 let text=pick(seeds);const index=Math.floor(random()*(text.length+1));
 if(random()<0.5)text=text.slice(0,index)+pick(chars)+text.slice(index);else text=text.slice(0,index)+text.slice(index+1);
 let expected;let nativeValid=true;try{expected=JSON.parse(text);}catch{nativeValid=false;}
 const parsed=parseReceiptJson(text,limits);
 try{assert.equal(parsed.ok,nativeValid);if(parsed.ok)assert.deepEqual(parsed.value,expected);}catch(error){failures.push({kind:'mutation',text,error:error.message});}
 mutationCases++;
}
const report={observedAt:new Date().toISOString(),node:process.version,seed:'0x72656365',sourceSha256:crypto.createHash('sha256').update(source).digest('hex'),validCases,mutationCases,failures,scope:'Deterministic finite grammar differential against native JSON.parse; duplicate-key policy separately covered in focused tests. No source or network writes.'};
fs.writeFileSync('/private/tmp/zodiacs-platform-receipt-final-review/json-differential.json',JSON.stringify(report,null,2)+'\n');console.log(JSON.stringify({...report,failures:failures.slice(0,5)},null,2));process.exitCode=failures.length?1:0;
