for(const source of ['2001-12-21T09:00:00-00:00','2001-12-21T16:00:00+07:00','2001-12-21T09:00Z','0000-02-29','0099-12-31T23:59:59.123Z'])run(`source spelling ${source}`,()=>{
 const chart=natalChart({utc:source,timeKnown:false});
 const envelope=codec.createNatalEnvelope(chart,{sourceInstant:source});
