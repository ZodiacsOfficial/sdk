function run(name,action){try{cases.push({name,observed:action()??'passed'});}catch(error){failures.push({name,error:error.constructor.name,message:error.message});}}
function localChart(date,time,timeZone,shift,timeKnown=true,reference='supplied-instant'){
 const resolved=resolveLocalToUtc(date,time,timeZone);
 const chart=natalChart({utc:resolved.utc,latitude:20,longitude:10,timeKnown,flags:resolved.flags,houseSystem:'placidus'});
 const context={reference,localResolution:{date,time,timeZone,offsetMinutes:resolved.offsetMinutes,gapShiftMinutes:shift,policy:{fold:'earlier',gap:'shift-forward'}}};
