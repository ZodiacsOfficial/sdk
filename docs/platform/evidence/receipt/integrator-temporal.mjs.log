for(const [name,date,time,zone,shift,known,reference] of [
 ['year zero leap UTC','0000-02-29','12:00','UTC',0,true,'supplied-instant'],
 ['year99 UTC','0099-12-31','23:59','UTC',0,true,'supplied-instant'],
 ['year zero offset boundary','0000-01-01','00:30','Etc/GMT-1',0,true,'supplied-instant'],
 ['Mexico City LMT seconds','1907-07-06','08:30','America/Mexico_City',0,true,'supplied-instant'],
 ['New York gap','2024-03-10','02:30','America/New_York',60,true,'supplied-instant'],
 ['New York fold','2024-11-03','01:30','America/New_York',0,true,'supplied-instant'],
 ['Lord Howe half-hour gap','2024-10-06','02:15','Australia/Lord_Howe',30,true,'supplied-instant'],
