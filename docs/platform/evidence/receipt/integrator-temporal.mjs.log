 expect(parsed.ok,'SourceInstant own round trip rejected');
 expect(parsed.envelope.receipt.sourceInstant===source,'Source spelling changed');
 expect(!JSON.stringify(codec.redactNatalEnvelope(parsed.envelope)).includes(source),'Redaction copied source instant');
