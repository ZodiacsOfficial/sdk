 let rejected=false;try{codec.createNatalEnvelope(natalChart({utc:instant,timeKnown:false}),{reference:'utc-noon'});}catch(error){rejected=error.code==='invalid_context';}expect(rejected,'Inexact noon claim accepted');
});
run('no codec Intl re-resolution or fetch',()=>{
 const chart=natalChart({utc:'2024-03-10T07:30:00Z',timeKnown:false,flags:['dst-gap']});
 const originalIntl=Intl.DateTimeFormat,originalFetch=globalThis.fetch;let attempted=0;
 Intl.DateTimeFormat=function(){attempted++;throw new Error('No runtime re-resolution permitted');};globalThis.fetch=()=>{attempted++;throw new Error('No network permitted');};
 try{codec.createNatalEnvelope(chart,{localResolution:{date:'2024-03-10',time:'02:30',timeZone:'America/New_York',offsetMinutes:-240,gapShiftMinutes:60,policy:{fold:'earlier',gap:'shift-forward'}}});}finally{Intl.DateTimeFormat=originalIntl;globalThis.fetch=originalFetch;}
 expect(attempted===0,'Codec consulted live Intl or network');
});
const report={observedAt:new Date().toISOString(),node:process.version,icu:process.versions.icu,tz:process.versions.tz,sourceSha256:crypto.createHash('sha256').update(fs.readFileSync(`${root}/packages/engine/src/receipt.ts`)).digest('hex'),cases,failures,scope:'Synthetic local source probes; temporal controls use this runtime ICU and public natal calculation before codec invocation. Not independent historical tzdb validation.'};
fs.writeFileSync('/private/tmp/zodiacs-platform-receipt-final-review/temporal.json',JSON.stringify(report,null,2)+'\n');console.log(JSON.stringify(report,null,2));process.exitCode=failures.length?1:0;
