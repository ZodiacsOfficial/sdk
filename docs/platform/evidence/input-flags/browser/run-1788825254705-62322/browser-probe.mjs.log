    window.__packedReceipt = await import('/receipt.js');
  });
  check('Candidate module import attempts no storage, fetch or Intl access', await page.evaluate(() => ['blocked', 'fetch', 'intl', 'violations'].every(name => window.__privacy[name].length === 0)));
  const requestsBeforeOffline = browserRequests.length;
  await context.setOffline(true);
  browserResult = await page.evaluate(browserCases, expectedVersion);
  checks.push(...browserResult.checks);
  observations = await page.evaluate(() => structuredClone(window.__privacy));
  check('Packed computation and receipt replay execute offline with zero fetch/storage attempts', observations.blocked.length === 0 && observations.fetch.length === 0 && blockedRoutes.length === 0 && browserRequests.length === requestsBeforeOffline);
  check('Only the exact four local static resources were requested, with no input values or bodies', browserRequests.length === 4 && browserRequests.every(request => request.method === 'GET' && request.postData === null && new URL(request.url).origin === baseURL && assets.has(new URL(request.url).pathname) && !new URL(request.url).search));
  check('Fresh context remains cookie-free without CSP or browser errors', (await context.cookies()).length === 0 && errors.length === 0 && consoleErrors.length === 0 && observations.violations.length === 0, { errors, consoleErrors, violations: observations.violations });
