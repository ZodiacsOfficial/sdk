  page.on('pageerror', error => errors.push(error.message));
  page.on('console', message => { if (message.type() === 'error') consoleErrors.push(message.text()); });
  await context.tracing.start({ screenshots: true, snapshots: true });
  await page.goto(baseURL, { waitUntil: 'load' });
  observerControls = await page.evaluate(async () => {
    try { void localStorage; } catch {}
    try { document.cookie = 'synthetic=1'; } catch {}
    try { navigator.sendBeacon('/observer-check', 'synthetic'); } catch {}
    try { await fetch('/observer-check'); } catch {}
    window.__privacy.blockIntl = true;
    try { new Intl.DateTimeFormat('en-US', { timeZone: 'UTC' }); } catch {}
    window.__privacy.blockIntl = false;
    const result = structuredClone(window.__privacy);
    for (const name of ['blocked', 'fetch', 'intl', 'violations']) window.__privacy[name].length = 0;
    return result;
  });
  check('Armed privacy and Intl observers detect negative controls without transmitting', JSON.stringify(observerControls.blocked) === '["localStorage","cookie-write","sendBeacon"]' && observerControls.fetch.length === 1 && observerControls.intl.length === 1 && browserRequests.length === 1);
  await page.evaluate(async () => {
