    assert(members.has(target.import.replace(/^\.\//, '')) && members.has(target.types.replace(/^\.\//, '')), 'Export targets must exist in archive');
  }
  identity = { consumer, archive, archiveSHA256: hash(archiveBytes), archiveBytes: archiveBytes.length, version: manifest.version, sourceCommitClaim, memberCount: members.size, unpackedBytes: memberHashes.reduce((sum, entry) => sum + entry.bytes, 0), memberHashes };
  await save('archive-members.json', identity);

  async function bundle(entry, label) {
    const result = await build({ absWorkingDir: consumer, stdin: { contents: `export * from ${JSON.stringify(entry)};`, resolveDir: consumer, sourcefile: `${label}-public-entry.mjs` }, bundle: true, platform: 'browser', format: 'esm', target: 'es2022', write: false, metafile: true, minify: false });
    assert.equal(result.outputFiles.length, 1);
    const inputs = [];
    for (const [name, facts] of Object.entries(result.metafile.inputs)) {
      const path = resolve(consumer, name);
      if (path === join(consumer, `${label}-public-entry.mjs`)) continue;
      const local = relative(consumer, path);
      assert(local.startsWith('node_modules/@zodiacs/engine/dist/') || local.startsWith('node_modules/astronomy-engine/'), 'Unexpected dependency outside packed engine/ephemeris graph');
      assert(!/solana|wallet|ownership|web3|@zodiacs\/sdk/i.test(local), 'Ownership module entered browser graph');
      inputs.push({ file: local, sha256: hash(await readFile(path)), imports: facts.imports });
    }
    await save(`${label}.bundle.js`, result.outputFiles[0].text);
    return { code: result.outputFiles[0].text, sha256: hash(result.outputFiles[0].contents), inputs, metafile: result.metafile };
  }
  const core = await bundle('@zodiacs/engine', 'root');
  const geo = await bundle('@zodiacs/engine/geo', 'geo');
  const receipt = await bundle('@zodiacs/engine/receipt', 'receipt');
  check('Optional geo and receipt graphs omit root ephemeris and ownership modules', [geo, receipt].every(graph => graph.inputs.every(input => input.file.startsWith('node_modules/@zodiacs/engine/dist/') && !/\/(?:index|ephemeris)\.js$/.test(input.file))) && ![geo.code, receipt.code].some(code => code.includes('function natalChart') || code.includes('getCrossChainZodiacsOwnership')));
  check('Core graph omits optional geo and receipt implementation', !core.inputs.some(input => /\/(?:geo|receipt)\.js$/.test(input.file)) && !core.code.includes('function createGeoNamesClient') && !core.code.includes('function parseNatalEnvelope'));
  graphs = Object.fromEntries(Object.entries({ root: core, geo, receipt }).map(([key, graph]) => [key, { sha256: graph.sha256, inputs: graph.inputs, metafile: graph.metafile }]));
  await save('bundle-graphs.json', { esbuild: esbuildVersion, ...graphs });

  const html = '<!doctype html><html lang="en"><meta charset="utf-8"><link rel="icon" href="data:,"><title>Installed rc.5 browser acceptance</title><body><h1>Installed rc.5 browser acceptance</h1><p id="status">Synthetic acceptance cases are prepared. Candidate modules load only after privacy observers are armed.</p><ol id="checks"></ol></body></html>';
  const assets = new Map([['/', { type: 'text/html', body: html }], ['/root.js', { type: 'text/javascript', body: core.code }], ['/geo.js', { type: 'text/javascript', body: geo.code }], ['/receipt.js', { type: 'text/javascript', body: receipt.code }]]);
  server = createServer((request, response) => {
    serverRequests.push({ method: request.method, path: request.url });
    const asset = assets.get(request.url);
    if (request.method !== 'GET' || !asset) { response.writeHead(404).end(); return; }
    response.writeHead(200, { 'Content-Type': `${asset.type}; charset=utf-8`, 'Cache-Control': 'no-store', 'Content-Security-Policy': "default-src 'none'; script-src 'self'; connect-src 'self'; img-src data:; base-uri 'none'; form-action 'none'" });
    response.end(asset.body);
  });
  await new Promise((resolve, reject) => { server.once('error', reject); server.listen(0, '127.0.0.1', resolve); });
  baseURL = `http://127.0.0.1:${server.address().port}`;
  await save('agent-browser-config.json', '{}\n');
  agentStarted = true;
  await agent('open', baseURL);
  await agent('wait', '--load', 'networkidle');
  const preflight = await agent('eval', 'JSON.stringify({content:document.body.innerText.trim().length>0,overlay:!!document.querySelector("[data-nextjs-dialog],.vite-error-overlay,#webpack-dev-server-client-overlay"),heading:document.querySelector("h1")?.textContent})');
  assert(preflight.includes('Installed rc.5 browser acceptance') && preflight.includes('true') && preflight.includes('false'), 'Static browser preflight failed');
  await agent('snapshot');
