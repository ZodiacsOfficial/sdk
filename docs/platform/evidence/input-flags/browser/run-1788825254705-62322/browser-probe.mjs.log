    Intl.DateTimeFormat = new Proxy(NativeFormatter, {
      construct(target, args, newTarget) { observed.intl.push('construct'); if (observed.blockIntl) throw new Error('Unexpected Intl access'); return Reflect.construct(target, args, newTarget); },
      apply(target, thisArg, args) { observed.intl.push('apply'); if (observed.blockIntl) throw new Error('Unexpected Intl access'); return Reflect.apply(target, thisArg, args); }
