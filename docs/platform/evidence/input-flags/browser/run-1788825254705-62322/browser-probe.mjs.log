  if (server?.listening) { server.closeIdleConnections(); await new Promise((resolve, reject) => server.close(error => error ? reject(error) : resolve())); cleanup.serverClosed = true; }
  cleanup.serverListening = server?.listening ?? false;
  const report = { status, runtime, identity, checks, browserResult, observations, observerControls, requests: browserRequests.map(request => ({ ...request, url: baseURL && request.url.startsWith(baseURL) ? new URL(request.url).pathname : request.url })), serverRequests, blockedRoutes, errors, consoleErrors, cleanup, failure,
    limitations: ['Finite synthetic cases in the observed Chrome runtime; no universal timezone or numerical-accuracy claim.', 'Source commit is an integrator-supplied provenance claim; exact archive hash and all installed member bytes are independently verified.', 'Supplied Chart checks establish flag-metadata consistency at call time, not verified numerical computation or authenticated provenance.', 'Local capability observers and an offline browser context do not sandbox hostile same-realm JavaScript.', 'Saturn calculation call counts are covered by source tests and independent source review; production bundles are not instrumented here.', 'No site migration, release publication, deployment, external network service or external adoption is exercised.'] };
