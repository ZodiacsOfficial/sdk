  await agent('screenshot', join(out, 'preflight.png'), '--full');
  await agent('close');
  cleanup.agentBrowserClosed = true;
  check('Actual agent-browser server preflight loads meaningful content without overlays or errors', true);

  const executablePath = await findChromium();
  browser = await chromium.launch({ executablePath, headless: true, args: STABLE_CHROMIUM_ARGS });
  runtime = { node: process.version, chrome: browser.version(), executablePath, esbuild: esbuildVersion, ephemeris: JSON.parse(await readFile(join(consumer, 'node_modules/astronomy-engine/package.json'), 'utf8')).version };
  context = await browser.newContext({ viewport: { width: 1120, height: 800 }, reducedMotion: 'reduce' });
  context.on('request', request => browserRequests.push({ url: request.url(), method: request.method(), postData: request.postData(), type: request.resourceType() }));
  await context.route('**/*', async route => {
