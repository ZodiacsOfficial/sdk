{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "noEmit": true,
    "rootDir": "."
  },
  "include": [
    "packages/engine/src/**/*.ts",
    "packages/sdk/src/**/*.ts",
    "packages/sdk/src/**/*.tsx",
    "packages/widgets/src/**/*.ts"
  ],
  "exclude": ["node_modules", "packages/*/dist"]
}
