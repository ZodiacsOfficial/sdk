{
  "name": "@zodiacs/widgets",
  "version": "0.1.0",
  "description": "Typed browser mounts for the official Zodiacs.org iframe widgets.",
  "license": "MIT",
  "keywords": [
    "astrology",
    "embed",
    "iframe",
    "moon-phase",
    "typescript",
    "widget",
    "zodiac"
  ],
  "homepage": "https://zodiacs.org/widgets/",
  "bugs": {
    "url": "https://github.com/ZodiacsOfficial/sdk/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZodiacsOfficial/sdk.git",
    "directory": "packages/widgets"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/*.d.ts",
    "dist/*.js",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean --tsconfig tsconfig.build.json",
    "exports:smoke": "node scripts/module-resolution-smoke.mjs",
    "package:contents": "node scripts/verify-package-contents.mjs",
    "pack:dry-run": "npm pack --dry-run",
    "prepack": "npm run build",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.typecheck.json --pretty false"
  }
}
